FROM node:lts-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:/root/.go/bin:/root/.bun/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y curl git gnupg wget python3 procps jq unzip build-essential ca-certificates \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && out=$(mktemp) && wget -nv -O"$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    && cat "$out" | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && mkdir -p -m 755 /etc/apt/sources.list.d \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/* "$out"

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

RUN curl -sL https://raw.githubusercontent.com/kerolloz/go-installer/master/go.sh | bash

RUN curl -fsSL https://bun.sh/install | bash

RUN npm i -g @earendil-works/pi-coding-agent@latest @getpaseo/cli@latest @opencode/cli@latest skills@latest pnpm@latest lighthouse@latest

RUN gh extension install github/gh-stack

COPY --chmod=755 harness/* /usr/local/bin/

ENTRYPOINT ["entrypoint"]
